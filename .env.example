# PostgreSQL connection (any Postgres 14+). On Netlify the site's Netlify Database is used when this is unset.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sadaf_360

# Secret used to sign session cookies (32+ characters). Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Public site address used in emailed links (password reset). Netlify sets URL automatically; set APP_URL for a custom domain.
# APP_URL=https://medsupply360.netlify.app

# Password-reset email through Brevo (https://www.brevo.com). Without these, "Forgot password" says it is not set up.
# MAIL_SENDER must be a sender address verified in Brevo.
# BREVO_API_KEY=
# MAIL_SENDER=
# MAIL_SENDER_NAME=MedSupply360

# Sign-up is closed unless this is set. With a value, /signup asks for it (create a company + owner only for people you gave the code).
# SIGNUP_INVITE_CODE=
